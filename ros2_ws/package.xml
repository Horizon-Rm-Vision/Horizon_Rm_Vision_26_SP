<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>udp_visualization_bridge</name>
  <version>0.1.0</version>
  <description>UDP(JSON) to ROS2 visualization bridge: MarkerArray for RViz2.</description>

  <maintainer email="todo@example.com">todo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- JSON library (system dependency via rosdep on Ubuntu) -->
  <depend>nlohmann-json3-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
